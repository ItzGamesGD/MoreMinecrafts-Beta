diff --git a/src/main/java/dev/itzgamesgd/moreminecrafts/pyramid/worldgen/St01Instr.java b/src/main/java/dev/itzgamesgd/moreminecrafts/pyramid/worldgen/St01Instr.java
new file mode 100644
index 00000000..1617b2d3
--- /dev/null
+++ b/src/main/java/dev/itzgamesgd/moreminecrafts/pyramid/worldgen/St01Instr.java
@@ -0,0 +1,27 @@
+package dev.itzgamesgd.moreminecrafts.pyramid.worldgen;
+
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** P8-D2-R1 DISPOSABLE instrumentation (worktree only; never committed to production). Off unless -Dmm.st01.instr=true. */
+public final class St01Instr {
+    public static final boolean ON = Boolean.getBoolean("mm.st01.instr");
+    private St01Instr() {}
+    static final class C { final AtomicLong n = new AtomicLong(), ns = new AtomicLong(), max = new AtomicLong(); }
+    private static final Map<String, C> M = new ConcurrentHashMap<>();
+    private static String thr() { return Thread.currentThread().getName().startsWith("Server thread") ? "main" : "worker"; }
+    public static void time(String k, long ns) {
+        C c = M.computeIfAbsent(k + "|" + thr(), x -> new C());
+        c.n.incrementAndGet(); c.ns.addAndGet(ns); c.max.accumulateAndGet(ns, Math::max);
+    }
+    public static void count(String k, long v) { M.computeIfAbsent(k + "|" + thr(), x -> new C()).n.addAndGet(v); }
+    public static void reset() { M.clear(); }
+    /** key -> {count, total ns, max ns} */
+    public static Map<String, long[]> snapshot() {
+        Map<String, long[]> out = new TreeMap<>();
+        M.forEach((k, c) -> out.put(k, new long[]{c.n.get(), c.ns.get(), c.max.get()}));
+        return out;
+    }
+}
